<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
    <SvgControlsVersion>12.0.0</SvgControlsVersion>
    <TextMateSharpVersion>2.0.0</TextMateSharpVersion>
  </PropertyGroup>
  <ItemGroup Label="Common">
    <PackageVersion Include="IgnoresAccessChecksToGenerator" Version="1.0.0" />
    <PackageVersion Include="Svg.Controls.Avalonia" Version="12.0.0.17" />
    <PackageVersion Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup Label="Avalonia">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />
  </ItemGroup>
  <ItemGroup Label="Markdown">
    <PackageVersion Include="Markdig" Version="1.4.1" />
    <PackageVersion Include="TextMateSharp" Version="2.0.4" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.4" />
    <PackageVersion Include="Sylinko.CSharpMath.Avalonia" Version="12.0.0" />
    <PackageVersion Include="Mermaider" Version="0.15.1" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.5.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup Label="ShadUI">
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="MinVer" Version="8.1.0-alpha.1" />
    <PackageVersion Include="Lucide.Avalonia" Version="0.2.26" />
    <PackageVersion Include="SkiaSharp" Version="4.156.0-preview.1.26512.10" />
    <PackageVersion Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
  </ItemGroup>
</Project>